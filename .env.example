# Application
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=verify-full
DIRECT_URL=postgresql://user:password@direct-host/database?sslmode=require

# GitHub App
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_PRIVATE_KEY=replace-with-private-key-pem
GITHUB_WEBHOOK_SECRET=

# Optional integrations
SLACK_WEBHOOK_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
